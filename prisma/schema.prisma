generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  GUEST
  DRIVER
  ORGANIZER
  SUPPLIER
  SUPER_ADMIN
  COORDINATOR
  LOGISTICS_MANAGER
  COMPANY_ORGANIZER
}

enum EventStatus {
  DRAFT
  PUBLISHED
  LIVE
  COMPLETED
  CANCELLED
}

enum RsvpStatus {
  INVITED
  CONFIRMED
  DECLINED
  ARRIVED
}

enum DriverStatus {
  OFFLINE
  AVAILABLE
  ASSIGNED
  EN_ROUTE
  BUSY
}

enum CaptainType {
  VIP_CAPTAIN
  SHUTTLE
  EMERGENCY
}

enum DriverZone {
  NORTH_RIYADH
  CENTRAL_RIYADH
  EAST_RIYADH
  WEST_RIYADH
  SOUTH_RIYADH
  DIRIYAH_CORRIDOR
  NORTH_ZONE
  CENTRAL_ZONE
  EAST_ZONE
  WEST_ZONE
  SUMMIT_CORRIDOR
}

enum TaskType {
  AIRPORT_PICKUP
  HOTEL_TRANSFER
  VENUE_TRANSFER
  RESTAURANT_PICKUP
  VIP_ESCORT
}

enum TaskStatus {
  PENDING
  ASSIGNED
  ACCEPTED
  EN_ROUTE
  ARRIVED
  PICKED_UP
  COMPLETED
  DELAYED
  CANCELLED
}

enum SupplierCategory {
  HOTEL
  CAR
  TICKET
  CATERING
  EQUIPMENT
  TOURISM
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
}

enum ActivityStatus {
  DRAFT
  AI_PLANNING
  PLAN_CONFIRMED
  QUOTING
  CONTRACTING
  OPERATIONS_OPEN
}

enum TransportationProfile {
  VIP
  SHUTTLE
  MIXED
}

enum TicketProfile {
  FIRST_CLASS
  NORMAL
  MIXED
}

enum HotelProfile {
  FIVE_STAR
  FOUR_STAR
  MIXED
}

enum CarProfile {
  LUXURY_SEDAN
  SUV_GMC_TAHOE
  MIXED
}

enum TaskHandoverKind {
  DELEGATE
  TRANSFER
  RETURN
}

enum QuoteStatus {
  REQUESTED
  RECEIVED
  RECOMMENDED
  APPROVED
  REJECTED
}

enum ContractStatus {
  DRAFT
  UNDER_REVIEW
  SIGNED
  ACTIVE
}

enum JourneyStage {
  ARRIVAL
  EVENT_TRANSPORTATION
  DEPARTURE
}

enum ArrivalStatus {
  PRE_ARRIVAL
  PASSPORT
  LUGGAGE
  GATE
  PICKED_UP
}

enum CoordinatorRequestStatus {
  NEW
  SENT_TO_SUPERVISOR
  ASSIGNED
  CLOSED
}

enum CompanyReportStatus {
  DRAFT
  MANAGER_CONFIRMED
  SENT_TO_COMPANY
}

enum FileAssetType {
  VISA
  TICKET
  GUEST_PHOTO
  DRIVER_PHOTO
  PROMO_VIDEO
  REPORT_PDF
  OTHER
}

// FULL-OVERHAUL-M2: organizations, event workspaces, onboarding, roster,
// dispatch and telemetry. The stored login Role and legacy EventStatus are
// unchanged; event roles below are per-event assignments, not login roles.

enum OrganizationKind {
  ORGANIZER_COMPANY
  VENDOR
  CLIENT
}

enum OrganizationRole {
  OWNER
  ADMIN
  MEMBER
}

enum MembershipStatus {
  ACTIVE
  REVOKED
}

enum EventMemberRole {
  COORDINATOR
  PROJECT_MANAGER
  LOGISTICS_MANAGER
  OPERATIONS_MANAGER
  PRODUCTION_MANAGER
  FLEET_SUPERVISOR
  CAPTAIN
  CLIENT_VIEWER
  VENDOR
}

enum EventSubteam {
  HOTELS
  AIRPORT
  VENUE
  TRANSPORT
}

enum EventPermission {
  VIEW
  EDIT
  INVITE
  SCOPE
}

enum OperationalStatus {
  PLANNING
  ACTIVE
  COMPLETED
}

enum PlanningMode {
  MANUAL
  AI
}

enum EventPlanStatus {
  DRAFT
  APPROVED
  SUPERSEDED
}

enum EventPlanSource {
  DETERMINISTIC_ADVISORY
  AI_PROVIDER
  MANUAL
}

enum OnboardingKind {
  VENDOR
  CLIENT
}

enum OnboardingStatus {
  SUBMITTED
  UNDER_REVIEW
  APPROVED
  REJECTED
  CONTRACT_SIGNED
  ACTIVE
}

enum OnboardingDocumentKind {
  COMMERCIAL_REGISTRATION
  TAX_CERTIFICATE
  IDENTITY
  SIGNED_CONTRACT
  OTHER
}

enum MessageClass {
  INDIVIDUAL
  GROUP
  ALERT
  INQUIRY
  TASK
}

enum TaskSource {
  CLIENT_TASK
  LOGISTICS_TEAM_TASK
}

enum DispatchFlow {
  GUEST_TO_LM
  GUEST_TO_SUPERVISOR
  GUEST_TO_CAPTAIN
  ORGANIZER_TO_LM
  LM_TO_SUPERVISOR
  LM_TO_CAPTAIN_EMERGENCY
}

enum VehicleStatus {
  AVAILABLE
  ASSIGNED_TO_TASK
  WAITING
  OUT_OF_ZONE
}

enum TripStatus {
  SCHEDULED
  EN_ROUTE_TO_PICKUP
  ON_BOARD
  COMPLETED
  CANCELLED
}

enum EtaSource {
  PROVIDER
  APPROXIMATE
  UNAVAILABLE
}

enum FlightScope {
  EVENT
  GENERAL
}

enum FlightStatus {
  SCHEDULED
  DELAYED
  LANDED
  DEPARTED
  CANCELLED
}

enum ShiftStatus {
  SCHEDULED
  ON_SHIFT
  OFF_SHIFT
}

model User {
  id              String         @id @default(cuid())
  name            String
  email           String         @unique
  phone           String         @unique
  role            Role           @default(GUEST)
  language        String         @default("ar")
  avatar          String?
  passwordHash    String
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  organizedEvents Event[]        @relation("OrganizerEvents")
  guestProfiles   Guest[]
  driverProfile   Driver?
  supplierProfile Supplier?
  notifications   Notification[]
  auditLogs       AuditLog[]     @relation("AuditActor")
  sentMessages    Message[]      @relation("SentMessages")
  receivedMessages Message[]     @relation("ReceivedMessages")
  supplierNotes   SupplierRequestNote[] @relation("SupplierNoteAuthor")
  responsibleTasks Task[]        @relation("TaskResponsible")
  delegatedTasks  Task[]         @relation("TaskDelegate")
  handoversFrom   TaskHandover[] @relation("TaskHandoverFrom")
  handoversTo     TaskHandover[] @relation("TaskHandoverTo")
  handoversActed  TaskHandover[] @relation("TaskHandoverActor")
  conversationsCreated Conversation[] @relation("ConversationCreator")
  conversationMemberships ConversationParticipant[]
  conversationMessages ConversationMessage[]

  // FULL-OVERHAUL-M2 back-relations.
  organizationsCreated      Organization[]           @relation("OrganizationCreator")
  organizationMemberships   OrganizationMembership[] @relation("OrganizationMember")
  organizationGrants        OrganizationMembership[] @relation("OrganizationMembershipGrantor")
  eventContractsSigned      Event[]                  @relation("EventContractSigner")
  eventMemberships          EventMembership[]        @relation("EventMember")
  eventMembershipGrants     EventMembership[]        @relation("EventMembershipGrantor")
  eventPlansGenerated       EventPlan[]              @relation("EventPlanGenerator")
  eventPlansApproved        EventPlan[]              @relation("EventPlanApprover")
  eventScopeChanges         EventScopeChange[]       @relation("EventScopeChangeActor")
  onboardingApplications    OnboardingApplication[]  @relation("OnboardingApplicant")
  onboardingReviews         OnboardingApplication[]  @relation("OnboardingReviewer")
  onboardingContractsSigned OnboardingApplication[]  @relation("OnboardingContractSigner")
  onboardingTransitions     OnboardingTransition[]   @relation("OnboardingTransitionActor")
  onboardingDocuments       OnboardingDocument[]     @relation("OnboardingDocumentUploader")
  guestPrivacyViews         GuestPrivacyGrant[]      @relation("GuestPrivacyViewer")
  guestPrivacyGrantsGiven   GuestPrivacyGrant[]      @relation("GuestPrivacyGrantor")
  createdTasks              Task[]                   @relation("TaskCreator")
  dispatchesSent            DispatchRecord[]         @relation("DispatchSender")
  dispatchesReceived        DispatchRecord[]         @relation("DispatchRecipient")
  dispatchesSupervised      DispatchRecord[]         @relation("DispatchSupervisor")
}

model CityConfig {
  id          String     @id @default(cuid())
  code        String     @unique
  nameAr      String
  nameEn      String
  centerLat   Float
  centerLng   Float
  defaultZoom Int        @default(12)
  timezone    String
  currency    String
  vatPercent  Decimal    @default(15) @db.Decimal(5, 2)
  enabled     Boolean    @default(true)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  events      Event[]
  suppliers   Supplier[]
}

model Event {
  id          String      @id @default(cuid())
  name        String
  date        DateTime
  venue       String
  venueLat    Float?
  venueLng    Float?
  cityId      String?
  organizerId String
  status      EventStatus @default(DRAFT)
  brief       String?
  timezone    String      @default("Asia/Riyadh")
  currency    String      @default("SAR")
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  // FULL-OVERHAUL-M2. A null organizationId marks a legacy event, which keeps
  // its existing (legacy route) scope and is not served by /workspace.
  organizationId     String?
  operationalStatus  OperationalStatus @default(PLANNING)
  planningMode       PlanningMode      @default(MANUAL)
  locationLabel      String?           @db.VarChar(200)
  hotelZone          String?           @db.VarChar(120)
  vipGuestCount      Int               @default(0)
  regularGuestCount  Int               @default(0)
  carCount           Int               @default(0)
  startAt            DateTime?
  endAt              DateTime?
  arrivalStartAt     DateTime?
  departureEndAt     DateTime?
  approvedPlanId     String?           @unique
  planApprovedAt     DateTime?
  contractSignedAt   DateTime?
  contractSignedById String?

  city        CityConfig? @relation(fields: [cityId], references: [id])
  organizer   User        @relation("OrganizerEvents", fields: [organizerId], references: [id])
  guests      Guest[]
  tasks       Task[]
  bookings    Booking[]

  organization     Organization?      @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  approvedPlan     EventPlan?         @relation("EventApprovedPlan", fields: [approvedPlanId], references: [id], onDelete: SetNull)
  contractSignedBy User?              @relation("EventContractSigner", fields: [contractSignedById], references: [id], onDelete: SetNull)
  memberships      EventMembership[]
  plans            EventPlan[]        @relation("EventPlans")
  scopeChanges     EventScopeChange[]
  rosterGuests     EventGuest[]
  privacyGrants    GuestPrivacyGrant[]
  conversations    Conversation[]
  dispatches       DispatchRecord[]
  vehicles         Vehicle[]
  trips            Trip[]
  flights          Flight[]
  captainShifts    CaptainShift[]
  densitySamples   DensitySample[]

  @@index([organizerId])
  @@index([status])
  @@index([organizationId, operationalStatus])
}

model Guest {
  id          String     @id @default(cuid())
  userId      String
  eventId     String
  rsvpStatus  RsvpStatus @default(INVITED)
  isVIP       Boolean    @default(false)
  qrCode      String     @unique
  tier        String     @default("standard")
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  user        User       @relation(fields: [userId], references: [id])
  event       Event      @relation(fields: [eventId], references: [id])
  tasks       Task[]
  hospitalityRider HospitalityRider?
  // FULL-OVERHAUL-M2: optional link from a roster record to this login guest.
  rosterRecord EventGuest?

  @@unique([userId, eventId])
  @@index([eventId])
}

model HospitalityRider {
  id              String   @id @default(cuid())
  guestId         String   @unique
  dietaryNeeds    Json
  roomPreferences Json
  vehicleRider    Json
  securityNotes   Json?
  fulfilled       Boolean  @default(false)
  fulfilledBy     String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  guest           Guest    @relation(fields: [guestId], references: [id], onDelete: Cascade)

  @@index([guestId, fulfilled])
}

model Driver {
  id              String       @id @default(cuid())
  userId          String       @unique
  licenseNo       String       @unique
  nationalIdIqama String
  currentLat      Float?
  currentLng      Float?
  zone            DriverZone   @default(CENTRAL_RIYADH)
  status          DriverStatus @default(OFFLINE)
  shiftStart      DateTime?
  shiftEnd        DateTime?
  earnings        Decimal      @default(0) @db.Decimal(10, 2)
  lastLocationAt  DateTime?
  captainType     CaptainType  @default(SHUTTLE)
  visitsCompleted Int          @default(0)
  overtimeAvailable Boolean    @default(false)
  active          Boolean      @default(true)
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  user            User         @relation(fields: [userId], references: [id])
  tasks           Task[]
  vehicles        Vehicle[]
  trips           Trip[]
  captainShifts   CaptainShift[]

  @@index([status, zone])
}

model Task {
  id              String     @id @default(cuid())
  eventId         String
  driverId        String?
  guestId         String?
  type            TaskType
  status          TaskStatus @default(PENDING)
  pickupLocation  String
  dropoffLocation String
  pickupLat       Float?
  pickupLng       Float?
  dropoffLat      Float?
  dropoffLng      Float?
  scheduledAt     DateTime
  deadlineAt      DateTime?
  ownerName       String?
  // OPS-COLLAB-001: the accountable operations user, and an optional
  // temporary delegate acting on their behalf.
  responsibleUserId String?
  delegateUserId  String?
  // FULL-OVERHAUL-M2: explicit client/logistics task classification, the
  // creating user and the dispatch thread. Null for legacy tasks.
  source          TaskSource?
  createdById     String?
  conversationId  String?
  completedAt     DateTime?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  event           Event      @relation(fields: [eventId], references: [id])
  driver          Driver?    @relation(fields: [driverId], references: [id])
  guest           Guest?     @relation(fields: [guestId], references: [id])
  responsibleUser User?      @relation("TaskResponsible", fields: [responsibleUserId], references: [id], onDelete: SetNull)
  delegateUser    User?      @relation("TaskDelegate", fields: [delegateUserId], references: [id], onDelete: SetNull)
  handovers       TaskHandover[]
  createdBy       User?          @relation("TaskCreator", fields: [createdById], references: [id], onDelete: SetNull)
  conversation    Conversation?  @relation(fields: [conversationId], references: [id], onDelete: SetNull)
  trip            Trip?
  dispatch        DispatchRecord?

  @@index([eventId, status])
  @@index([driverId])
  @@index([guestId])
  @@index([responsibleUserId])
  @@index([delegateUserId])
  @@index([eventId, source])
  @@index([conversationId])
}

/// OPS-COLLAB-001: append-only history of task delegations and transfers.
model TaskHandover {
  id          String           @id @default(cuid())
  taskId      String
  kind        TaskHandoverKind
  fromUserId  String?
  toUserId    String?
  actorUserId String
  reason      String?          @db.VarChar(500)
  createdAt   DateTime         @default(now())

  task        Task             @relation(fields: [taskId], references: [id], onDelete: Cascade)
  fromUser    User?            @relation("TaskHandoverFrom", fields: [fromUserId], references: [id], onDelete: SetNull)
  toUser      User?            @relation("TaskHandoverTo", fields: [toUserId], references: [id], onDelete: SetNull)
  actor       User             @relation("TaskHandoverActor", fields: [actorUserId], references: [id], onDelete: Cascade)

  @@index([taskId, createdAt])
  @@index([toUserId, createdAt])
}

model Supplier {
  id                String           @id @default(cuid())
  userId            String?          @unique
  cityId            String?
  name              String
  category          SupplierCategory
  rating            Float            @default(4.5)
  verified          Boolean          @default(false)
  crNumber          String?
  commissionPercent Decimal          @default(12) @db.Decimal(5, 2)
  sponsoredRank     Int?
  zone              DriverZone?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  user              User?            @relation(fields: [userId], references: [id])
  city              CityConfig?      @relation(fields: [cityId], references: [id])
  services          Service[]
  bookings          Booking[]
  quotes            VendorQuote[]
  requestNotes      SupplierRequestNote[]

  @@index([category, verified])
  @@index([sponsoredRank])
}

model Service {
  id          String   @id @default(cuid())
  supplierId  String
  name        String
  price       Decimal  @db.Decimal(10, 2)
  unit        String
  available   Boolean  @default(true)
  description String?
  metadata    Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  supplier    Supplier @relation(fields: [supplierId], references: [id])
  bookings    Booking[]

  @@index([supplierId, available])
}

model Booking {
  id                String        @id @default(cuid())
  eventId           String
  supplierId        String
  serviceId         String
  quantity          Int
  totalPrice        Decimal       @db.Decimal(12, 2)
  commissionPercent Decimal       @default(12) @db.Decimal(5, 2)
  commissionAmount  Decimal       @default(0) @db.Decimal(12, 2)
  status            BookingStatus @default(PENDING)
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  event             Event         @relation(fields: [eventId], references: [id])
  supplier          Supplier      @relation(fields: [supplierId], references: [id])
  service           Service       @relation(fields: [serviceId], references: [id])

  @@index([eventId])
  @@index([supplierId])
}

model CommissionConfig {
  id                       String            @id @default(cuid())
  category                 SupplierCategory? @unique
  defaultPercent           Decimal           @default(12) @db.Decimal(5, 2)
  minPercent               Decimal           @default(10) @db.Decimal(5, 2)
  maxPercent               Decimal           @default(15) @db.Decimal(5, 2)
  sponsoredPlacementPrice  Decimal           @default(1500) @db.Decimal(10, 2)
  createdAt                DateTime          @default(now())
  updatedAt                DateTime          @updatedAt
}

model Notification {
  id              String   @id @default(cuid())
  userId          String
  title           String
  body            String
  channel         String   @default("IN_APP")
  deliveryStatus  String   @default("queued")
  provider        String?
  recipientPhone  String?
  metadata        Json?
  read            Boolean  @default(false)
  createdAt       DateTime @default(now())

  user            User     @relation(fields: [userId], references: [id])

  @@index([userId, read])
  @@index([channel, deliveryStatus])
}

model AuditLog {
  id          String   @id @default(cuid())
  actorUserId String?
  actorRole   Role?
  action      String
  entityType  String
  entityId    String
  eventId     String?
  beforeData  Json?
  afterData   Json?
  metadata    Json?
  ipAddress   String?
  userAgent   String?
  createdAt   DateTime @default(now())

  actor      User?    @relation("AuditActor", fields: [actorUserId], references: [id])

  @@index([actorUserId, createdAt])
  @@index([entityType, entityId])
  @@index([eventId, createdAt])
  @@index([action, createdAt])
}

model Message {
  id         String   @id @default(cuid())
  senderId   String
  receiverId String
  body       String
  createdAt  DateTime @default(now())

  sender     User     @relation("SentMessages", fields: [senderId], references: [id])
  receiver   User     @relation("ReceivedMessages", fields: [receiverId], references: [id])

  @@index([senderId, receiverId])
}

model ActivityIntake {
  id                 String                @id @default(cuid())
  eventId            String?
  activityName       String
  activityPlace      String
  visitorCount       Int
  vipVisitorCount    Int
  normalVisitorCount Int
  transportationType TransportationProfile @default(MIXED)
  ticketType         TicketProfile         @default(MIXED)
  hotelType          HotelProfile          @default(MIXED)
  carType            CarProfile            @default(MIXED)
  status             ActivityStatus        @default(DRAFT)
  submittedBy        String
  submittedAt        DateTime              @default(now())
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt

  supplierNotes      SupplierRequestNote[]

  @@index([eventId])
  @@index([status])
}

model AiLogisticsPlan {
  id                String   @id @default(cuid())
  intakeId          String
  summary           String
  assumptions       Json
  visitorGrouping   String
  vipCars           Int
  shuttleVehicles   Int
  hotelRooms        Int
  firstClassTickets Int
  normalTickets     Int
  phases            Json
  risks             Json
  confirmed         Boolean  @default(false)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([intakeId])
}

model VendorQuote {
  id                String      @id @default(cuid())
  intakeId          String
  category          String
  vendorName        String
  item              String
  quantity          Int
  unitPrice         Decimal     @db.Decimal(12, 2)
  totalPrice        Decimal     @db.Decimal(12, 2)
  commissionPercent Decimal     @db.Decimal(5, 2)
  commissionAmount  Decimal     @db.Decimal(12, 2)
  score             Int
  status            QuoteStatus @default(REQUESTED)
  isVaultSealed     Boolean     @default(false)
  // SUPPLIER-001: set only for a supplier's own initial submission. Legacy
  // manual quotes stay null (no vendorName backfill).
  supplierId        String?
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  supplier          Supplier?   @relation(fields: [supplierId], references: [id], onDelete: Restrict)

  @@unique([supplierId, intakeId, category])
  @@index([intakeId])
  @@index([status])
  @@index([supplierId])
}

/// SUPPLIER-001: append-only supplier recommendation on a request.
model SupplierRequestNote {
  id           String         @id @default(cuid())
  intakeId     String
  supplierId   String
  authorUserId String
  text         String         @db.VarChar(2000)
  createdAt    DateTime       @default(now())

  intake       ActivityIntake @relation(fields: [intakeId], references: [id], onDelete: Restrict)
  supplier     Supplier       @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  author       User           @relation("SupplierNoteAuthor", fields: [authorUserId], references: [id], onDelete: Restrict)

  @@index([intakeId, createdAt])
  @@index([supplierId, createdAt])
}

model VaultSession {
  id             String    @id @default(cuid())
  intakeId       String    @unique
  status         String    @default("LOCKED")
  key1User       String?
  key1Role       String?
  key1ApprovedAt DateTime?
  key2User       String?
  key2Role       String?
  key2ApprovedAt DateTime?
  key3User       String?
  key3Role       String?
  key3ApprovedAt DateTime?
  unlockedAt     DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([intakeId])
  @@index([status])
}

model VendorContract {
  id               String         @id @default(cuid())
  quoteId          String
  vendorName       String
  category         String
  amount           Decimal        @db.Decimal(12, 2)
  commissionAmount Decimal        @db.Decimal(12, 2)
  status           ContractStatus @default(DRAFT)
  signedAt         DateTime?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  @@index([quoteId])
  @@index([status])
}

model GuestJourneyRecord {
  id                    String       @id @default(cuid())
  guestId               String
  stage                 JourneyStage @default(ARRIVAL)
  visaStatus            String       @default("READY")
  ticketStatus          String       @default("READY")
  promoVideos           Json
  arrivalStatus         ArrivalStatus @default(PRE_ARRIVAL)
  arrivalGate           String
  luggageStatus         String       @default("WAITING")
  driverName            String
  driverPhoto           String?
  driverPhone           String
  carDetails            String
  etaMinutes            Int
  personalTripRequests  Json
  notes                 Json
  complaints            Json
  departureFlight       String
  departurePickupTime   DateTime
  departureConfirmed    Boolean      @default(false)
  leavingWithMidyaf     Boolean      @default(true)
  createdAt             DateTime     @default(now())
  updatedAt             DateTime     @updatedAt

  @@index([guestId])
  @@index([stage])
}

model CoordinatorRequest {
  id         String                   @id @default(cuid())
  guestName  String
  request    String
  route      String
  priority   String                   @default("NORMAL")
  status     CoordinatorRequestStatus @default(NEW)
  supervisor String
  deadline   DateTime
  createdAt  DateTime                 @default(now())
  updatedAt  DateTime                 @updatedAt

  @@index([status])
  @@index([deadline])
}

model CompanyReport {
  id        String              @id @default(cuid())
  title     String
  status    CompanyReportStatus @default(DRAFT)
  kpis      Json
  pdfUrl    String?
  updatedAt DateTime            @updatedAt
  createdAt DateTime            @default(now())

  @@index([status])
}

model CaptainFeedback {
  id        String   @id @default(cuid())
  driverId  String
  taskId    String
  rating    Int
  note      String
  createdAt DateTime @default(now())

  @@index([driverId])
  @@index([taskId])
}

model FileAsset {
  id        String        @id @default(cuid())
  type      FileAssetType
  url       String
  key       String
  mimeType  String
  size      Int
  userId    String?
  guestId   String?
  driverId  String?
  eventId   String?
  createdAt DateTime      @default(now())

  @@index([type])
  @@index([userId])
  @@index([guestId])
  @@index([driverId])
  @@index([eventId])
}

/// OPS-COLLAB-001: built-in messaging between platform users.
model Conversation {
  id            String   @id @default(cuid())
  subject       String   @db.VarChar(150)
  createdById   String
  lastMessageAt DateTime @default(now())
  createdAt     DateTime @default(now())

  // FULL-OVERHAUL-M2 classification. Defaults keep plain messages INDIVIDUAL;
  // visibility stays participant-only whatever these say.
  eventId       String?
  messageClass  MessageClass  @default(INDIVIDUAL)
  dispatchFlow  DispatchFlow?

  createdBy     User     @relation("ConversationCreator", fields: [createdById], references: [id], onDelete: Cascade)
  participants  ConversationParticipant[]
  messages      ConversationMessage[]
  event         Event?   @relation(fields: [eventId], references: [id], onDelete: SetNull)
  tasks         Task[]
  dispatches    DispatchRecord[] @relation("DispatchConversation")
  alertDispatches DispatchRecord[] @relation("DispatchAlertConversation")

  @@index([lastMessageAt])
  @@index([eventId, messageClass])
}

// ---------------------------------------------------------------------------
// FULL-OVERHAUL-M2 models
// ---------------------------------------------------------------------------

/// Tenant boundary for organizer companies, vendors and clients.
model Organization {
  id             String            @id @default(cuid())
  name           String            @db.VarChar(160)
  slug           String            @unique @db.VarChar(80)
  kind           OrganizationKind
  vendorCategory SupplierCategory?
  createdById    String?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  createdBy              User?                    @relation("OrganizationCreator", fields: [createdById], references: [id], onDelete: SetNull)
  memberships            OrganizationMembership[]
  events                 Event[]
  onboardingApplication  OnboardingApplication?

  @@index([kind])
}

model OrganizationMembership {
  id             String           @id @default(cuid())
  organizationId String
  userId         String
  role           OrganizationRole @default(MEMBER)
  status         MembershipStatus @default(ACTIVE)
  grantedById    String?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation("OrganizationMember", fields: [userId], references: [id], onDelete: Cascade)
  grantedBy    User?        @relation("OrganizationMembershipGrantor", fields: [grantedById], references: [id], onDelete: SetNull)

  @@unique([organizationId, userId])
  @@index([userId, status])
}

/// Explicit per-event assignment: event role, subteam, granular permissions,
/// client visibility and receiver/availability controls.
model EventMembership {
  id            String            @id @default(cuid())
  eventId       String
  userId        String
  role          EventMemberRole
  subteam       EventSubteam?
  workScope     String? @db.VarChar(2000)
  permissions   EventPermission[] @default([VIEW])
  clientVisible Boolean           @default(false)
  canReceive    Boolean           @default(true)
  available     Boolean           @default(true)
  status        MembershipStatus  @default(ACTIVE)
  grantedById   String?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  event     Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user      User  @relation("EventMember", fields: [userId], references: [id], onDelete: Cascade)
  grantedBy User? @relation("EventMembershipGrantor", fields: [grantedById], references: [id], onDelete: SetNull)

  @@unique([eventId, userId])
  @@index([userId, status])
  @@index([eventId, role, status])
}

/// Versioned event plan. Advisory output is never operational until an
/// explicit approval.
model EventPlan {
  id            String          @id @default(cuid())
  eventId       String
  version       Int
  status        EventPlanStatus @default(DRAFT)
  source        EventPlanSource
  advisory      Boolean         @default(true)
  summary       String          @db.VarChar(2000)
  content       Json
  generatedById String
  approvedById  String?
  approvedAt    DateTime?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  event       Event  @relation("EventPlans", fields: [eventId], references: [id], onDelete: Cascade)
  approvedFor Event? @relation("EventApprovedPlan")
  generatedBy User   @relation("EventPlanGenerator", fields: [generatedById], references: [id], onDelete: Restrict)
  approvedBy  User?  @relation("EventPlanApprover", fields: [approvedById], references: [id], onDelete: SetNull)

  @@unique([eventId, version])
  @@index([eventId, status])
}

/// Pre-contract scope edit with the number of vendor notifications enqueued.
model EventScopeChange {
  id                  String   @id @default(cuid())
  eventId             String
  actorUserId         String
  changedFields       String[]
  beforeData          Json
  afterData           Json
  notifiedVendorCount Int      @default(0)
  createdAt           DateTime @default(now())

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  actor User  @relation("EventScopeChangeActor", fields: [actorUserId], references: [id], onDelete: Restrict)

  @@index([eventId, createdAt])
}

model OnboardingApplication {
  id                 String            @id @default(cuid())
  kind               OnboardingKind
  status             OnboardingStatus  @default(SUBMITTED)
  applicantUserId    String
  organizationId     String?           @unique
  companyName        String            @db.VarChar(160)
  registrationNumber String?           @db.VarChar(60)
  vendorCategory     SupplierCategory?
  contactName        String            @db.VarChar(120)
  contactEmail       String            @db.VarChar(254)
  contactPhone       String            @db.VarChar(32)
  city               String?           @db.VarChar(80)
  notes              String?           @db.VarChar(2000)
  reviewerUserId     String?
  decisionNote       String?           @db.VarChar(1000)
  submittedAt        DateTime          @default(now())
  reviewStartedAt    DateTime?
  decidedAt          DateTime?
  contractSignedAt   DateTime?
  contractSignedById String?
  activatedAt        DateTime?
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  applicant        User                   @relation("OnboardingApplicant", fields: [applicantUserId], references: [id], onDelete: Restrict)
  reviewer         User?                  @relation("OnboardingReviewer", fields: [reviewerUserId], references: [id], onDelete: SetNull)
  contractSignedBy User?                  @relation("OnboardingContractSigner", fields: [contractSignedById], references: [id], onDelete: SetNull)
  organization     Organization?          @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  documents        OnboardingDocument[]
  transitions      OnboardingTransition[]

  @@index([applicantUserId, kind])
  @@index([status, submittedAt])
}

/// Append-only onboarding state history.
model OnboardingTransition {
  id            String            @id @default(cuid())
  applicationId String
  fromStatus    OnboardingStatus?
  toStatus      OnboardingStatus
  actorUserId   String
  note          String?           @db.VarChar(1000)
  createdAt     DateTime          @default(now())

  application OnboardingApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  actor       User                  @relation("OnboardingTransitionActor", fields: [actorUserId], references: [id], onDelete: Restrict)

  @@index([applicationId, createdAt])
}

/// Private, bounded document bytes held in the database (no public URL and
/// no ephemeral disk). Served only to the applicant and reviewers.
model OnboardingDocument {
  id            String                 @id @default(cuid())
  applicationId String
  kind          OnboardingDocumentKind
  fileName      String                 @db.VarChar(160)
  mimeType      String                 @db.VarChar(100)
  sizeBytes     Int
  sha256        String                 @db.VarChar(64)
  content       Bytes
  uploadedById  String
  createdAt     DateTime               @default(now())

  application OnboardingApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  uploadedBy  User                  @relation("OnboardingDocumentUploader", fields: [uploadedById], references: [id], onDelete: Restrict)

  @@index([applicationId, createdAt])
}

/// Standardized event roster record (guest code G01/GV01). Optionally linked
/// to a login Guest; imported guests need no account.
model EventGuest {
  locationConsent Boolean @default(false)
  lastLat Float?
  lastLng Float?
  lastSeenAt DateTime?
  id            String    @id @default(cuid())
  eventId       String
  guestCode     String    @db.VarChar(16)
  isVip         Boolean   @default(false)
  fullName      String    @db.VarChar(160)
  contactPhone  String?   @db.VarChar(32)
  contactEmail  String?   @db.VarChar(254)
  roomType      String?   @db.VarChar(60)
  hotelName     String?   @db.VarChar(160)
  arrivalAt     DateTime?
  departureAt   DateTime?
  ticketNumber  String?   @db.VarChar(40)
  originCity    String?   @db.VarChar(80)
  arrivalCity   String?   @db.VarChar(80)
  departureCity String?   @db.VarChar(80)
  privacyMasked Boolean   @default(false)
  privacyGroup  String?   @db.VarChar(40)
  guestId       String?   @unique
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  event         Event               @relation(fields: [eventId], references: [id], onDelete: Cascade)
  guest         Guest?              @relation(fields: [guestId], references: [id], onDelete: SetNull)
  privacyGrants GuestPrivacyGrant[]
  tripSeats     TripPassenger[]

  @@unique([eventId, guestCode])
  @@index([eventId, privacyGroup])
}

/// Allowed viewer of one masked guest (eventGuestId) or of a privacy group
/// (groupKey); exactly one of the two is set.
model GuestPrivacyGrant {
  id           String   @id @default(cuid())
  eventId      String
  eventGuestId String?
  groupKey     String?  @db.VarChar(40)
  viewerUserId String
  grantedById  String
  createdAt    DateTime @default(now())

  event      Event       @relation(fields: [eventId], references: [id], onDelete: Cascade)
  eventGuest EventGuest? @relation(fields: [eventGuestId], references: [id], onDelete: Cascade)
  viewer     User        @relation("GuestPrivacyViewer", fields: [viewerUserId], references: [id], onDelete: Cascade)
  grantedBy  User        @relation("GuestPrivacyGrantor", fields: [grantedById], references: [id], onDelete: Restrict)

  @@unique([eventGuestId, viewerUserId])
  @@unique([eventId, groupKey, viewerUserId])
  @@index([viewerUserId])
}

/// One authorized dispatch (six flows). The thread, optional task and the
/// emergency supervisor alert are created in the same transaction.
model DispatchRecord {
  id                  String       @id @default(cuid())
  eventId             String
  flow                DispatchFlow
  senderUserId        String
  senderEventRole     String       @db.VarChar(40)
  recipientUserId     String
  recipientCount      Int          @default(1)
  supervisorUserId    String?
  conversationId      String
  alertConversationId String?
  taskId              String?      @unique
  emergency           Boolean      @default(false)
  clientRequestId     String?      @db.VarChar(64)
  createdAt           DateTime     @default(now())

  event             Event         @relation(fields: [eventId], references: [id], onDelete: Cascade)
  sender            User          @relation("DispatchSender", fields: [senderUserId], references: [id], onDelete: Restrict)
  recipient         User          @relation("DispatchRecipient", fields: [recipientUserId], references: [id], onDelete: Restrict)
  supervisor        User?         @relation("DispatchSupervisor", fields: [supervisorUserId], references: [id], onDelete: SetNull)
  conversation      Conversation  @relation("DispatchConversation", fields: [conversationId], references: [id], onDelete: Cascade)
  alertConversation Conversation? @relation("DispatchAlertConversation", fields: [alertConversationId], references: [id], onDelete: SetNull)
  task              Task?         @relation(fields: [taskId], references: [id], onDelete: SetNull)

  @@unique([senderUserId, clientRequestId])
  @@index([eventId, createdAt])
  @@index([flow])
}

model Vehicle {
  id          String        @id @default(cuid())
  eventId     String
  plateNumber String        @db.VarChar(20)
  label       String        @db.VarChar(80)
  capacity    Int           @default(4)
  status      VehicleStatus @default(AVAILABLE)
  driverId    String?
  lastLat     Float?
  lastLng     Float?
  lastSeenAt  DateTime?
  inZone      Boolean       @default(true)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  event  Event   @relation(fields: [eventId], references: [id], onDelete: Cascade)
  driver Driver? @relation(fields: [driverId], references: [id], onDelete: SetNull)
  trips  Trip[]

  @@unique([eventId, plateNumber])
  @@index([eventId, status])
  @@index([driverId])
}

/// Trip with route, in-zone flag and the two separate ETAs (captain to
/// guest, guest to destination). PROVIDER ETAs come only from the server.
model Trip {
  id                    String     @id @default(cuid())
  eventId               String
  vehicleId             String?
  driverId              String?
  taskId                String?    @unique
  status                TripStatus @default(SCHEDULED)
  originLabel           String     @db.VarChar(160)
  originLat             Float?
  originLng             Float?
  destinationLabel      String     @db.VarChar(160)
  destinationLat        Float?
  destinationLng        Float?
  routePolyline         String?    @db.VarChar(20000)
  inZone                Boolean?
  captainEtaMinutes     Int?
  destinationEtaMinutes Int?
  etaSource             EtaSource  @default(UNAVAILABLE)
  etaUpdatedAt          DateTime?
  scheduledAt           DateTime
  startedAt             DateTime?
  completedAt           DateTime?
  createdAt             DateTime   @default(now())
  updatedAt             DateTime   @updatedAt

  event      Event           @relation(fields: [eventId], references: [id], onDelete: Cascade)
  vehicle    Vehicle?        @relation(fields: [vehicleId], references: [id], onDelete: SetNull)
  driver     Driver?         @relation(fields: [driverId], references: [id], onDelete: SetNull)
  task       Task?           @relation(fields: [taskId], references: [id], onDelete: SetNull)
  passengers TripPassenger[]

  @@index([eventId, status])
  @@index([driverId, status])
  @@index([vehicleId])
}

model TripPassenger {
  id           String   @id @default(cuid())
  tripId       String
  eventGuestId String
  createdAt    DateTime @default(now())

  trip       Trip       @relation(fields: [tripId], references: [id], onDelete: Cascade)
  eventGuest EventGuest @relation(fields: [eventGuestId], references: [id], onDelete: Cascade)

  @@unique([tripId, eventGuestId])
  @@index([eventGuestId])
}

/// Event flight (eventId set) or general airport flight (eventId null).
model Flight {
  id              String       @id @default(cuid())
  scope           FlightScope
  eventId         String?
  flightNumber    String       @db.VarChar(12)
  airline         String?      @db.VarChar(80)
  originCode      String       @db.VarChar(8)
  destinationCode String       @db.VarChar(8)
  scheduledAt     DateTime
  estimatedAt     DateTime?
  status          FlightStatus @default(SCHEDULED)
  dataSource      String       @default("MANUAL") @db.VarChar(20)
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  event Event? @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([eventId, scheduledAt])
  @@index([scope, scheduledAt])
}

model CaptainShift {
  id        String      @id @default(cuid())
  eventId   String
  driverId  String
  startsAt  DateTime
  endsAt    DateTime
  status    ShiftStatus @default(SCHEDULED)
  available Boolean     @default(true)
  zoneLabel String?     @db.VarChar(80)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  event  Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)
  driver Driver @relation(fields: [driverId], references: [id], onDelete: Cascade)

  @@index([eventId, startsAt])
  @@index([driverId, startsAt])
}

/// Aggregate headcount per zone only; no person-level location.
model DensitySample {
  id         String   @id @default(cuid())
  eventId    String
  zoneKey    String   @db.VarChar(40)
  capturedAt DateTime
  headcount  Int
  capacity   Int?
  source     String   @default("MANUAL") @db.VarChar(20)
  createdAt  DateTime @default(now())

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([eventId, zoneKey, capturedAt])
}

model ConversationParticipant {
  id             String       @id @default(cuid())
  conversationId String
  userId         String
  lastReadAt     DateTime?
  joinedAt       DateTime     @default(now())

  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([conversationId, userId])
  @@index([userId])
}

model ConversationMessage {
  id             String       @id @default(cuid())
  conversationId String
  senderId       String
  body           String       @db.VarChar(5000)
  createdAt      DateTime     @default(now())

  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender         User         @relation(fields: [senderId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
}
